{
  "git.enabled": false,
  "git.autorefresh": false,
  "git.autoRepositoryDetection": false,
  "search.exclude": {
    "**/build": true,
    "**/outputs": true,
    "**/.venv": true,
    "**/vendor/ecdict": true,
    "**/work": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/outputs/**": true,
    "**/.venv/**": true,
    "**/vendor/ecdict/**": true,
    "**/work/**": true
  },
  "files.exclude": {
    "**/work/entries": true
  }
}
